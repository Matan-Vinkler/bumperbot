<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main">
  <BehaviorTree ID="main">
    <RecoveryNode number_of_retries="1">
      <PipelineSequence>
        <RateController hz="1">
          <ComputePathToPose goal="{goal}" planner_id="GridBasedSMAC" path="{path}"/>
        </RateController>
        <FollowPath controller_id="RegulatedPurePursuit" path="{path}"/>
      </PipelineSequence>
      <Sequence>
        <Spin spin_dist="1.57"/>
        <Wait wait_duration="5"/>
        <BackUp backup_dist="0.3" backup_speed="0.15"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
