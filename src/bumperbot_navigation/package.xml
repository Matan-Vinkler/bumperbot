<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bumperbot_navigation</name>
  <version>0.0.0</version>
  <description>Navigation stack for BumperBot using Nav2 with obstacle avoidance, costmap, path planning (Dijkstra and A*), and trajectory control.</description>
  <maintainer email="matanvinkler@gmail.com">matan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
